{
  "conventions": "glTF 2.0 binaire, Y haut, 1 unité = 1 m, origine aux pieds, face vers +Z, pas de compression Draco/meshopt",
  "animationSource": {
    "title": "Universal Animation Library [Standard]",
    "author": "Quaternius",
    "license": "CC0 1.0",
    "url": "https://quaternius.com/packs/universalanimationlibrary.html",
    "note": "clips reciblés (retarget) dans Blender sur le squelette propre à chaque personnage ; marche sur place"
  },
  "sharedSkeleton": false,
  "sharedSkeletonNote": "Pas de squelette commun aux 6 fichiers : person-01 et person-04 ont chacun leur rig ; person-02/03/05/06 partagent les mêmes noms d'os (Hips, Spine, Chest, UpperChest, …) mais des proportions différentes. Chaque GLB embarque ses propres clips : ne pas les partager entre personnages.",
  "clipNotes": {
    "walk": "boucle, sur place ; déplacer la racine à walkSpeed m/s pour éviter le patinage",
    "idle": "boucle, debout au repos",
    "sit": "boucle, assis, mains sur les cuisses ; le bassin est à sitHip (x, y=hauteur, z) par rapport à l'origine : reculer la chaise de -z ; hauteur d'assise ≈ hipPosition.y − 0,10 m (≈ 0,45–0,48 m)",
    "talk": "boucle, debout, parle en gesticulant",
    "sit_talk": "boucle, assis, parle en gesticulant",
    "drive": "boucle, assis, mains sur un volant (bras tendus vers +Z) ; même repère de bassin que sit (hipPosition)"
  },
